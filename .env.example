# Copy to .env.local and fill in. None of these are secrets (NEXT_PUBLIC_* values ship to the browser).

# Final public URL, used for canonical links, Open Graph and sitemap.xml (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. A form-handling endpoint that accepts JSON via POST and returns 2xx on success
# (e.g. a serverless function, Formspree, Getform). When empty, the contact and school forms
# validate and then open the visitor's email app; they never claim a message was sent.
NEXT_PUBLIC_FORM_ENDPOINT=
